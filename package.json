{
  "name": "prewind",
  "version": "2.1.2",
  "description": "A lightweight preprocessor that expands Tailwind shorthand like hover(px-4 py-2) into hover:px-4 hover:py-2.",
  "keywords": [
    "art70x",
    "cli",
    "preprocessor",
    "shorthand",
    "tailwindcss",
    "utility"
  ],
  "homepage": "https://github.com/art70x/Prewind#readme",
  "bugs": {
    "url": "https://github.com/art70x/Prewind/issues"
  },
  "license": "MIT",
  "author": "art70x <art70x@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/art70x/Prewind.git"
  },
  "bin": {
    "prewind": "./dist/bin/cli.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "nr build:browser && nr build:cli",
    "build:browser": "vp pack -c tsdown.config.ts",
    "build:cli": "vp pack -c tsdown.config.cli.ts",
    "dev": "vp pack --watch",
    "check": "vp check",
    "lint": "vp lint . --fix",
    "format": "vp fmt src/",
    "prepublishOnly": "nr build",
    "type-check": "tsc -b",
    "up": "taze major -I",
    "prepare": "vp config"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.1.0",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "taze": "^21.3.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.18.0"
}
